# Neighborhood Commons — Environment Variables
#
# Copy this file to .env and fill in the values.
# For local development with Supabase CLI, run `supabase start`
# and use the values from `supabase status`.

# ─── Required ─────────────────────────────────────────────

# Supabase project credentials
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Audit log hashing salt (min 16 characters, any random string)
AUDIT_SALT=change-me-to-something-random

# ─── Optional ─────────────────────────────────────────────

# Server port (default: 3001)
# PORT=3001

# IP filtering (default: true, set false for local dev)
# IP_FILTER_ENABLED=false

# CORS origins (default: production domains)
# CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# API base URL (auto-detected on Railway, set manually for local)
# API_BASE_URL=http://localhost:3001

# ─── Portal Admin ────────────────────────────────────────

# Comma-separated Supabase auth UUIDs for admin access
# COMMONS_ADMIN_USER_IDS=

# ─── Email (Resend) ──────────────────────────────────────
# Required for developer registration OTP emails.
# Get a free API key at https://resend.com

# RESEND_API_KEY=re_...
# RESEND_FROM_DOMAIN=neighborhood-commons.org

# ─── Image Hosting (Cloudflare R2) ───────────────────────
# Optional. Without these, image uploads are disabled.

# COMMONS_R2_ACCOUNT_ID=
# COMMONS_R2_ACCESS_KEY_ID=
# COMMONS_R2_SECRET_ACCESS_KEY=
# COMMONS_R2_BUCKET_NAME=neighborhood-commons-images
# R2_PUBLIC_URL=https://images.neighborhood-commons.org

# ─── CAPTCHA (Cloudflare Turnstile) ─────────────────────
# Optional. Registration protected by rate limiting without it.

# CAPTCHA_ENABLED=false
# TURNSTILE_SECRET_KEY=

# ─── Cron & Internal Auth ────────────────────────────────

# Cron endpoint auth (min 16 chars)
# CRON_SECRET=

# Internal service-to-service sync (min 32 chars)
# COMMONS_SERVICE_KEY=

# ─── Webhooks ────────────────────────────────────────────

# AES-256-GCM key for signing secret encryption at rest (64 hex chars)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WEBHOOK_ENCRYPTION_KEY=

# ─── External APIs ──────────────────────────────────────

# Google Places API (venue search in portal)
# GOOGLE_PLACES_API_KEY=

# ─── Data Defaults ──────────────────────────────────────

# Default region UUID for new events (from regions table)
# DEFAULT_REGION_ID=
