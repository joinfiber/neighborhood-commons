{
  "name": "neighborhood-commons-server",
  "version": "0.2.0",
  "description": "Open neighborhood data infrastructure. Public REST API, server-rendered homepage, OpenAPI spec viewer. (The SDK consumers install lives in /sdk and is published as `neighborhood-commons`.)",
  "type": "module",
  "main": "dist/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/joinfiber/neighborhood-commons.git"
  },
  "homepage": "https://api.neighborhood-commons.org",
  "keywords": [
    "events",
    "api",
    "neighborhood",
    "commons",
    "open-data",
    "neighborhood-api",
    "community"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest",
    "test:run": "vitest run",
    "db:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > src/lib/database.types.ts",
    "sdk:health": "tsx scripts/sdk-health.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.98.0",
    "@types/multer": "^2.1.0",
    "@types/qrcode": "^1.5.6",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.1.0",
    "marked": "^18.0.4",
    "multer": "^2.1.1",
    "node-addon-api": "^8.3.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "undici": "^6.25.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "openapi-typescript": "^7.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20"
  }
}
